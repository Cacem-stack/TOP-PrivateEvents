<h1> Users#show </h1>

<%= "Created events:"%><br/><br/>
<% current_user.created_events.each do |event| %>
  <%= render "events/event", event: event %><br/>
  <%= link_to "Invite a friend", new_event_attending_path(event_id: event.id)%>
  <br/>
  <br/>
<% end%>
</br>

<%= "Future events:"%><br/><br/>
<% current_user.attended_events.where("date > ?", Date.today).each do |event| %>
  <%= render "events/event", event: event %><br/>
<% end %>
<br/>
<%= "Past events:"%><br/><br/>
<% current_user.attended_events.where("date <= ?", Date.today).each do |event| %>
  <%= render "events/event", event: event %>
<% end %>
