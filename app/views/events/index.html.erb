<h1>Events#index</h1>

<% if user_signed_in? %>
  <%= link_to "New event", new_event_path %>
<% end %>

<ul>
  <% @events.each do |event| %>
    <%= render event %>
    <% if user_signed_in? %>
      <%= button_to "Attend Event", event_attending_index_path(event_id: event.id) %>
    <% end %>
  <% end %>
</ul>
