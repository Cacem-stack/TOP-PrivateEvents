<h1>Events#index</h1>

<% if user_signed_in? %>
  <%= link_to "New event", new_event_path %>
<% end %>

<ul>
  <b><%= "Upcoming Events:" %></b>
  <% Event.past.each do |event| %>
    <% if user_signed_in? && (event.attendees.where("name = ?", current_user.name).any? || event.creator_id == current_user.id) %>
      <%= render event %>
      <%= button_to "Attend Event", event_attendings_path(event_id: event.id) %>
    <% end %>
  <% end %>
  <br/>
  <b><%= "Past Events:" %></b>
  <% Event.upcoming.each do |event| %>
    <% if user_signed_in? && (event.attendees.where("name = ?", current_user.name).any? || event.creator_id == current_user.id) %>
      <%= render event %>
      <%= button_to "Attend Event", event_attendings_path(event_id: event.id) %>
      <br/>
    <% end %>
  <% end %>
</ul>
